# AskData 配置模板
#
# 用法：
#   cp .env.example .env
#   然后把 .env 里的 Key 填上（.env 已加入 .gitignore，不会被提交）
#
# 优先级：命令行 export 的值 > .env 文件 > 代码默认值


# ============================================================
# 大模型供应商（二选一，DeepSeek 优先）
# ============================================================

# DeepSeek：申请地址 https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_CHAT_URL=https://api.deepseek.com/chat/completions

# 阿里云百炼
# DASHSCOPE_API_KEY=
# DASHSCOPE_WORKSPACE_ID=
# DASHSCOPE_CHAT_MODEL=qwen-plus


# ============================================================
# 本地向量 / 精排模型
# ============================================================
# DeepSeek 没有 Embedding 和 Rerank 服务，这两路走本地 bge 开源模型。
# 设为 1 启用；不设则走 Mock（哈希伪向量 + 规则排序），Demo 秒开不下载模型。
ASKDATA_LOCAL_MODELS=1

# ASKDATA_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# ASKDATA_RERANK_MODEL=BAAI/bge-reranker-base
# ASKDATA_DEVICE=mps
